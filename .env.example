# Provider API keys. Keys are only read by this process and never stored in the DB.
# Providers with key_required: false still accept a key when present.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=

# Optional: generic JSON webhook (Slack/Discord/ntfy/n8n compatible).
CATALOGWATCH_WEBHOOK_URL=

# Optional: quota extraction through an OpenAI-compatible endpoint, e.g. the local
# freellmapi router. Enable `extractor.enabled: true` in config/providers.yaml first.
FREELMAPI_KEY=

# --- Container / WorkBuddy bridge -------------------------------------------
# The image built by GitHub Actions, e.g.
# FREE_LLM_API_IMAGE=ghcr.io/your-user/llm-api-agg:latest
FREE_LLM_API_IMAGE=

# Optional. If empty, the container generates one and stores it in
# /data/secrets/admin_token. Back up /data if you care about the generated value.
CB_GATEWAY_ADMIN_TOKEN=

# Console login token. If empty, the container generates one and stores it in
# /data/secrets/catalogwatch_admin_token. Read it from there to log in at :8788.
CATALOGWATCH_ADMIN_TOKEN=

# Pepper for hashed pool API keys (next phase). If empty, the container
# generates /data/secrets/pool_key_pepper. Losing it invalidates pool keys.
CATALOGWATCH_KEY_PEPPER=
# Optional. If empty, Buddy2api creates /data/buddy2api/buddy2api.db.credentials.key.
# Back up that file with the database; without it, stored WorkBuddy tokens cannot be read.
CB_GATEWAY_MASTER_KEY=
TZ=Asia/Shanghai

# Local development only. The container bootstrap creates and exports this key
# automatically; set it manually only if you run the bridge outside the image.
WORKBUDDY_GATEWAY_KEY=
