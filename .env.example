# --- Container / WorkBuddy bridge -------------------------------------------
# The image built by GitHub Actions, e.g.
# FREE_LLM_API_IMAGE=ghcr.io/your-user/llm-api-agg:latest
FREE_LLM_API_IMAGE=

# Optional. If empty, the container generates one and stores it in
# /data/secrets/admin_token. Back up /data if you care about the generated value.
CB_GATEWAY_ADMIN_TOKEN=

# Console login account. Defaults are admin/admin; override them here (or in
# the console environment) before exposing :80 beyond your machine.
CATALOGWATCH_ADMIN_USER=admin
CATALOGWATCH_ADMIN_PASSWORD=admin

# Console login token. If empty, the container generates one and stores it in
# /data/secrets/catalogwatch_admin_token. Read it from there to log in at :80.
CATALOGWATCH_ADMIN_TOKEN=

# Pepper for hashed pool API keys. If empty, the container generates
# /data/secrets/pool_key_pepper. Losing it invalidates pool keys.
CATALOGWATCH_KEY_PEPPER=

# Optional. If empty, Buddy2api creates /data/buddy2api/buddy2api.db.credentials.key.
# Back up that file with the database; without it, stored WorkBuddy tokens cannot be read.
CB_GATEWAY_MASTER_KEY=
# Bridge channels loaded by Buddy2api. A channel with no imported account is skipped.
CB_GATEWAY_PROVIDERS=workbuddy,workbuddy-i,qoder,qoder-i,qwenwork,traework
# Channels the pool scans for models/accounts. Keep a subset if you only want some.
WORKBUDDY_PROVIDERS=workbuddy,workbuddy-i,qoder,qoder-i,qwenwork,traework
# Optional OpenBridge sidecar (see https://github.com/uncensoredcode/openbridge).
# Leave empty to disable. When it runs on the host, use:
# OPENBRIDGE_URL=http://host.docker.internal:4318
# The console's OpenBridge page can change URL/API key at runtime without restart.
OPENBRIDGE_URL=
OPENBRIDGE_API_KEY=
# Optional fallback when OpenBridge has no /v1/models endpoint:
# OPENBRIDGE_MODELS=provider/model,provider/model
OPENBRIDGE_MODELS=
OPENBRIDGE_SUPPORTS_TOOL_CALL=true
OPENBRIDGE_SUPPORTS_REASONING=true
OPENBRIDGE_SUPPORTS_IMAGES=false
OPENBRIDGE_CONTEXT_WINDOW=128000
OPENBRIDGE_MAX_OUTPUT=16384
TZ=Asia/Shanghai

# Local development only. The container bootstrap creates and exports this key
# automatically; set it manually only if you run the bridge outside the image.
WORKBUDDY_GATEWAY_KEY=
